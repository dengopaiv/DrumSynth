<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>DrumSynth</AssemblyName>
    <RootNamespace>DrumSynth</RootNamespace>
    <Version>3.0.0</Version>
    <Authors>Paul Kellett (original), Modern port contributors</Authors>
    <Description>Drum sound synthesizer - Modern WPF edition with accessibility support</Description>
    <Copyright>Original (c) 1998-2000 Paul Kellett. MIT/GPL-2.0 dual license.</Copyright>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Native\ds2wav.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
